#!/usr/bin/expect -f
# Password SSH to a lab VM (no sshpass on the Mac).
#   LAB_PASS='...' scripts/lab-ssh <user>@<host> <command...>
# Answers the login prompt and any "[sudo] password" prompt with $LAB_PASS; allocates a
# tty (-tt) so sudo can prompt. Exits with the remote command's status.
# The prompt regex must match both "user@host's password:" and "[sudo] password for
# user:" (the latter has no "password:" substring) — a helper that only matches the
# first hangs forever at the first sudo (2026-09-16).
set timeout 600
set target [lindex $argv 0]
set cmd [join [lrange $argv 1 end] " "]
if {![info exists env(LAB_PASS)]} { puts stderr "LAB_PASS not set"; exit 1 }
set pass $env(LAB_PASS)
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
    -o PreferredAuthentications=password -o PubkeyAuthentication=no -tt $target $cmd
expect {
  -re "(?i)password( for \\S+)?:" { send "$pass\r"; exp_continue }
  -re "Permission denied \\(publickey|Permission denied, please try again" { puts stderr "AUTH FAILED"; exit 2 }
  eof
}
lassign [wait] pid spawnid os_err rc
exit $rc
