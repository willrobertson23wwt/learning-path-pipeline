# ElevenLabs API key for narration generation
ELEVENLABS_API_KEY=your_api_key_here

# ElevenLabs voice ID for narration
ELEVENLABS_VOICE_ID=your_voice_id_here

# TTS model, pinned per path (record it in CLAUDE.md's platform profile)
ELEVENLABS_MODEL_ID=eleven_v3

# Optional. eleven_v3 stability takes 0.0 (Creative), 0.5 (Natural), or
# 1.0 (Robust); 1.0 is the most consistent for narration.
# ELEVENLABS_STABILITY=1.0

# Optional. A fixed seed keeps a retake close to the approved take.
# ELEVENLABS_SEED=12345
